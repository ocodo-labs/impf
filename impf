class ImageItem:
    """All state associated with one image."""

    def __init__(
        self,
        path: Path,
        image: Image.Image,
        detected_background: RGBColor,
    ) -> None:
        self.path: Path = path
        self.image: Image.Image = image

        self.detected_background: RGBColor = (
            detected_background
        )

        self.custom_background: RGBColor | None = (
            None
        )

        # Persistent editing state.
        self.crop_ratio: CropRatio = None
        self.size_mode: SizeMode = "fit"
        self.padding: int = 0

        # GTK widgets.
        self.button: Gtk.Button | None = None
        self.picture: Gtk.Picture | None = None
        self.texture: Gdk.Texture | None = None

    @property
    def background(self) -> RGBColor:
        if self.custom_background is not None:
            return self.custom_background

        return self.detected_background


