    # ========================================================================
    # Monitor / thumbnail sizing
    # ========================================================================

    def get_tile_size(
        self,
    ) -> tuple[int, int]:
        """
        Return approximately 1/8 of the current monitor dimensions.
        """
        display: Gdk.Display | None = (
            Gdk.Display.get_default()
        )

        if display is None:
            return 240, 135

        monitor: Gdk.Monitor | None = None

        surface: Gdk.Surface | None = (
            self.get_surface()
        )

        if surface is not None:
            try:
                monitor = (
                    display.get_monitor_at_surface(
                        surface
                    )
                )
            except Exception:
                monitor = None

        if monitor is None:
            monitors: Gio.ListModel = (
                display.get_monitors()
            )

            if monitors.get_n_items() > 0:
                monitor = monitors.get_item(0)

        if monitor is None:
            return 240, 135

        geometry: Gdk.Rectangle = (
            monitor.get_geometry()
        )

        width: int = max(
            160,
            geometry.width // SCREEN_DIVISOR,
        )

        height: int = max(
            90,
            geometry.height // SCREEN_DIVISOR,
        )

        return width, height

