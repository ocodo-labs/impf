    def load_folder(
        self,
        folder: Path,
    ) -> None:
        self.current_folder = folder

        self.items.clear()
        self.selected_item = None

        self.editor_mode = None

        self.flowbox.remove_all()

        self.update_editor_visibility()
        self.update_selection_ui()

        self.folder_label.set_text(
            str(folder)
        )

        self.status_label.set_text(
            "Scanning images…"
        )

        self.save_button.set_sensitive(
            False
        )

        try:
            files: list[Path] = sorted(
                (
                    path
                    for path in folder.iterdir()
                    if (
                        path.is_file()
                        and path.suffix.lower()
                        in SUPPORTED_EXTENSIONS
                    )
                ),
                key=lambda path: path.name.lower(),
            )
        except OSError as exc:
            self.status_label.set_text(
                f"Could not read folder: {exc}"
            )
            return

        if not files:
            self.status_label.set_text(
                "No supported images were found."
            )
            return

        self.status_label.set_text(
            f"Loading {len(files)} image(s)…"
        )

        worker: threading.Thread = (
            threading.Thread(
                target=self.load_images_worker,
                args=(files, folder),
                daemon=True,
            )
        )

        worker.start()

    def load_images_worker(
        self,
        files: list[Path],
        folder: Path,
    ) -> None:
        futures: dict[
            Future[ImageLoadResult],
            Path,
        ] = {
            self.executor.submit(
                load_image,
                path,
            ): path
            for path in files
        }

        loaded: list[
            ImageLoadResult
        ] = []

        errors: list[
            tuple[Path, str]
        ] = []

        for future in as_completed(
            futures
        ):
            path: Path = futures[future]

            try:
                loaded.append(
                    future.result()
                )
            except Exception as exc:
                errors.append(
                    (
                        path,
                        str(exc),
                    )
                )

        loaded.sort(
            key=lambda value: (
                value[0].name.lower()
            )
        )

        GLib.idle_add(
            self.finish_loading_images,
            loaded,
            errors,
            folder,
        )

    def finish_loading_images(
        self,
        loaded: list[ImageLoadResult],
        errors: list[tuple[Path, str]],
        folder: Path,
    ) -> bool:
        if self.current_folder != folder:
            return False

        for path, image, background in loaded:
            item: ImageItem = ImageItem(
                path,
                image,
                background,
            )

            self.items.append(item)

            self.add_thumbnail(
                item
            )

        count: int = len(self.items)

        if errors:
            self.status_label.set_text(
                f"Loaded {count} image(s); "
                f"{len(errors)} could not be read."
            )
        else:
            self.status_label.set_text(
                f"{count} image(s) loaded."
            )

        self.save_button.set_sensitive(
            count > 0
        )

        return False

    # ========================================================================
    # Thumbnail handling
    # ========================================================================

    def add_thumbnail(
        self,
        item: ImageItem,
    ) -> None:
        preview: Image.Image = (
            make_preview(
                item.image,
                item.background,
                self.tile_size,
                item.crop_ratio,
                item.size_mode,
                item.padding,
            )
        )

        item.texture = image_to_texture(
            preview
        )

        picture: Gtk.Picture = (
            Gtk.Picture.new_for_paintable(
                item.texture
            )
        )

        picture.set_content_fit(
            Gtk.ContentFit.CONTAIN
        )

        picture.set_can_shrink(
            True
        )

        picture.set_size_request(
            self.tile_size[0],
            self.tile_size[1],
        )

        item.picture = picture

        button: Gtk.Button = (
            Gtk.Button()
        )

        button.set_child(
            picture
        )

        button.set_size_request(
            self.tile_size[0],
            self.tile_size[1],
        )

        button.add_css_class(
            "thumbnail-button"
        )

        button.set_tooltip_text(
            item.path.name
        )

        button.connect(
            "clicked",
            self.on_thumbnail_clicked,
            item,
        )

        item.button = button

        self.flowbox.append(
            button
        )

    def refresh_thumbnail(
        self,
        item: ImageItem,
        *,
        pending_crop_ratio: CropRatio | None = None,
        pending_size_mode: SizeMode | None = None,
        pending_padding: int | None = None,
    ) -> None:
        if item.picture is None:
            return

        crop_ratio: CropRatio = (
            item.crop_ratio
            if pending_crop_ratio is None
            else pending_crop_ratio
        )

        size_mode: SizeMode = (
            item.size_mode
            if pending_size_mode is None
            else pending_size_mode
        )

        padding: int = (
            item.padding
            if pending_padding is None
            else max(0, pending_padding)
        )

        preview: Image.Image = (
            make_preview(
                item.image,
                item.background,
                self.tile_size,
                crop_ratio,
                size_mode,
                padding,
            )
        )

        item.texture = image_to_texture(
            preview
        )

        item.picture.set_paintable(
            item.texture
        )

