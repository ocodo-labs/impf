    def on_save_folder_selected(
        self,
        dialog: Gtk.FileDialog,
        result: Gio.AsyncResult,
    ) -> None:
        try:
            folder: Gio.File | None = (
                dialog.select_folder_finish(
                    result
                )
            )
        except GLib.Error:
            return

        if folder is None:
            return

        path: str | None = (
            folder.get_path()
        )

        if path is None:
            return

        save_folder: Path = Path(path)

        self.save_button.set_sensitive(
            False
        )

