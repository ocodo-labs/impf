            "Saving images…"
        )

        worker: threading.Thread = (
            threading.Thread(
                target=self.save_images_worker,
                args=(save_folder,),
                daemon=True,
            )
        )

        worker.start()

    def save_images_worker(
        self,
        save_folder: Path,
    ) -> None:
        try:
            save_folder.mkdir(
                parents=True,
                exist_ok=True,
            )

            tile_width: int
            tile_height: int

            tile_width, tile_height = (
                self.tile_size
            )

            aspect_ratio: float = (
                tile_width / tile_height
            )

            saved: int = 0

            errors: list[
                tuple[str, str]
            ] = []

            for item in self.items:
                try:
                    output: Image.Image = (
                        make_output_image(
                            item.image,
                            item.background,
                            aspect_ratio,
                            item.crop_ratio,
                            item.size_mode,
                            item.padding,
                        )
                    )

                    output_path: Path = (
                        save_folder
                        / f"{item.path.stem}.png"
                    )

                    # Don't overwrite the source image.
                    if (
                        output_path.resolve()
                        == item.path.resolve()
                    ):
                        output_path = (
                            save_folder
                            / (
                                f"{item.path.stem}"
                                "_background.png"
                            )
                        )

                    output.save(
                        output_path,
                        "PNG",
                        optimize=True,
                    )

                    saved += 1

                except Exception as exc:
                    errors.append(
                        (
                            item.path.name,
                            str(exc),
                        )
                    )

            GLib.idle_add(
                self.finish_saving,
                saved,
                errors,
                save_folder,
            )

        except Exception as exc:
            GLib.idle_add(
                self.save_failed,
                str(exc),
            )

    def finish_saving(
        self,
        saved: int,
        errors: list[tuple[str, str]],
        folder: Path,
    ) -> bool:
        self.save_button.set_sensitive(
            bool(self.items)
        )

        if errors:
            self.status_label.set_text(
                f"Saved {saved} image(s) to "
                f"{folder}; "
                f"{len(errors)} failed."
            )
        else:
            self.status_label.set_text(
                f"Saved {saved} image(s) to "
                f"{folder}."
            )

        return False

    def save_failed(
        self,
        message: str,
    ) -> bool:
        self.save_button.set_sensitive(
            bool(self.items)
        )

        self.status_label.set_text(
            f"Save failed: {message}"
        )

        return False

    # ========================================================================
    # Cancel folder / exit
    # ========================================================================

    def on_cancel_folder(
        self,
        _button: Gtk.Button,
    ) -> None:
        """
        Discard the current folder and open folder selection again.
        """
        self.items.clear()

        self.selected_item = None
        self.current_folder = None

        self.editor_mode = None

        self.flowbox.remove_all()

        self.folder_label.set_text(
            "No folder selected"
        )

        self.status_label.set_text(
            "Choose another image folder."
        )

        self.save_button.set_sensitive(
            False
        )

        self.update_editor_visibility()
        self.update_selection_ui()

        self.open_folder_dialog()

    def on_exit(
        self,
        _button: Gtk.Button,
    ) -> None:
        application: Gtk.Application | None = (
            self.get_application()
        )

        if application is not None:
            application.quit()

    def on_close_request(
        self,
        _window: Gtk.Window,
    ) -> bool:
        self.executor.shutdown(
            wait=False,
            cancel_futures=True,
        )

        return False


# ============================================================================
# Application
# ============================================================================

class ImageBackgroundApplication(
    Gtk.Application
):
    def __init__(self) -> None:
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.DEFAULT_FLAGS,
        )

    def do_activate(self) -> None:
        window: Gtk.Window | None = (
            self.get_active_window()
        )

        if window is None:
            window = MainWindow(self)

        window.present()


# ============================================================================
# Entry point
# ============================================================================

def main() -> int:
    application: ImageBackgroundApplication = (
        ImageBackgroundApplication()
    )

    return application.run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
