    def update_editor_visibility(
        self,
    ) -> None:
        has_selection: bool = (
            self.selected_item is not None
        )

        if not has_selection:
            self.crop_button.set_visible(
                False
            )

            self.pad_button.set_visible(
                False
            )

            self.size_button.set_visible(
                False
            )

            self.set_bg_button.set_visible(
                False
            )

            self.clear_selection_button.set_visible(
                False
            )

            self.crop_controls.set_visible(
                False
            )

            self.pad_controls.set_visible(
                False
            )

            self.size_controls.set_visible(
                False
            )

            return

        self.crop_button.set_visible(
            self.editor_mode != "crop"
        )

        self.pad_button.set_visible(
            self.editor_mode != "pad"
        )

        self.size_button.set_visible(
            self.editor_mode != "size"
        )

        self.set_bg_button.set_visible(
            self.editor_mode is None
        )

        self.clear_selection_button.set_visible(
            self.editor_mode is None
        )

        self.crop_controls.set_visible(
            self.editor_mode == "crop"
        )

        self.pad_controls.set_visible(
            self.editor_mode == "pad"
        )

        self.size_controls.set_visible(
            self.editor_mode == "size"
        )

        self.update_editor_button_state()

    def update_editor_button_state(
        self,
    ) -> None:
        if self.editor_mode == "crop":
            for ratio, button in (
                self.crop_buttons.items()
            ):
                if ratio == self.pending_crop_ratio:
                    button.add_css_class(
                        "suggested-action"
                    )
                else:
                    button.remove_css_class(
                        "suggested-action"
                    )

        elif self.editor_mode == "size":
            for mode, button in (
                self.size_buttons.items()
            ):
                if mode == self.pending_size_mode:
                    button.add_css_class(
                        "suggested-action"
                    )
                else:
                    button.remove_css_class(
                        "suggested-action"
                    )

