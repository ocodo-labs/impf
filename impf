def ratio_value(ratio: str) -> float:
    """Convert '16:9' into a floating point aspect ratio."""
    width, height = ratio.split(":")

    return int(width) / int(height)


def pad_image(
    image: Image.Image,
    padding: int,
    background: RGBColor,
) -> Image.Image:
    """
    Add equal padding around all four sides of the image.

    The padding is filled with the selected background color.
    """
    source: Image.Image = ImageOps.exif_transpose(
        image
    ).convert("RGBA")

    padding = max(0, int(padding))

    if padding == 0:
        return source.copy()

    width: int
    height: int
    width, height = source.size

    canvas: Image.Image = Image.new(
        "RGBA",
        (
            width + padding * 2,
            height + padding * 2,
        ),
        (*background, 255),
    )

    canvas.alpha_composite(
        source,
        (padding, padding),
    )

    return canvas


def crop_image(
    image: Image.Image,
    ratio: CropRatio,
) -> Image.Image:
    """
    Center-crop an image to the requested aspect ratio.

    If ratio is None, the image is returned unchanged.
    """
    source: Image.Image = ImageOps.exif_transpose(
        image
    ).convert("RGBA")

    if ratio is None:
        return source.copy()

    target_ratio: float = ratio_value(ratio)

    width: int
    height: int
    width, height = source.size

    current_ratio: float = width / height

    if math.isclose(
        current_ratio,
        target_ratio,
        rel_tol=1e-6,
    ):
        return source.copy()

    if current_ratio > target_ratio:
        # Image is too wide.
        # Crop horizontally.
        new_width: int = max(
            1,
            round(height * target_ratio),
        )

        left: int = (width - new_width) // 2

        return source.crop(
            (
                left,
                0,
                left + new_width,
                height,
            )
        )

    # Image is too tall.
    # Crop vertically.
    new_height: int = max(
        1,
        round(width / target_ratio),
    )

    top: int = (height - new_height) // 2

    return source.crop(
        (
            0,
            top,
            width,
            top + new_height,
        )
    )


def detect_background(
    image: Image.Image,
) -> RGBColor:
    """
    Estimate the background color by sampling the four corners.

    Colors are quantized before counting so slightly different shades
    are grouped together.
    """
    rgb: Image.Image = image.convert("RGB")

    width: int
    height: int
    width, height = rgb.size

    sample_width: int = max(
        2,
        int(width * 0.08),
    )

    sample_height: int = max(
        2,
        int(height * 0.08),
    )

    regions: list[Image.Image] = [
        rgb.crop(
            (
                0,
                0,
                sample_width,
                sample_height,
            )
        ),
        rgb.crop(
            (
                width - sample_width,
                0,
                width,
                sample_height,
            )
        ),
        rgb.crop(
            (
                0,
                height - sample_height,
                sample_width,
                height,
            )
        ),
        rgb.crop(
            (
                width - sample_width,
                height - sample_height,
                width,
                height,
            )
        ),
    ]

    samples: list[tuple[int, int, int]] = []

    for region in regions:
        region.thumbnail(
            (32, 32),
            Image.Resampling.BILINEAR,
        )

        samples.extend(
            (
                int(r),
                int(g),
                int(b),
            )
            for r, g, b in region.getdata()
        )

    if not samples:
        return 128, 128, 128

    buckets: Counter[
        tuple[int, int, int]
    ] = Counter(
        (
            (r // 16) * 16,
            (g // 16) * 16,
            (b // 16) * 16,
        )
        for r, g, b in samples
    )

    bucket: tuple[int, int, int] = (
        buckets.most_common(1)[0][0]
    )

    matching: list[
        tuple[int, int, int]
    ] = [
        pixel
        for pixel in samples
        if all(
            abs(
                pixel[channel]
                - bucket[channel]
            ) <= 16
            for channel in range(3)
        )
    ]

    if not matching:
        matching = samples

    result: list[int] = []

    for channel in range(3):
        values: list[int] = sorted(
            pixel[channel]
            for pixel in matching
        )

        result.append(
            values[len(values) // 2]
        )

    return (
        result[0],
        result[1],
        result[2],
    )


def apply_size_mode(
    image: Image.Image,
    canvas_size: tuple[int, int],
    size_mode: SizeMode,
) -> Image.Image:
    """
    Scale an image to a canvas.

    fit:
        Entire image remains visible.

    fill:
        Image covers the entire canvas and overflow is cropped.
    """
    canvas_width: int
    canvas_height: int
    canvas_width, canvas_height = canvas_size

    source: Image.Image = image.convert("RGBA")

    if size_mode == "fill":
        return ImageOps.fit(
            source,
            (canvas_width, canvas_height),
            method=Image.Resampling.LANCZOS,
            centering=(0.5, 0.5),
        )

    return ImageOps.contain(
        source,
        (canvas_width, canvas_height),
        method=Image.Resampling.LANCZOS,
    )


def make_preview(
    image: Image.Image,
    background: RGBColor,
    tile_size: tuple[int, int],
    crop_ratio: CropRatio,
    size_mode: SizeMode,
    padding: int = 0,
) -> Image.Image:
    """
    Create the thumbnail preview.

    Processing order:

        original image
             ↓
        crop
             ↓
        padding
             ↓
        Fit/Fill into screen-aspect preview area
    """
    tile_width: int
    tile_height: int
    tile_width, tile_height = tile_size

    canvas: Image.Image = Image.new(
        "RGBA",
        (tile_width, tile_height),
        (*background, 255),
    )

    cropped: Image.Image = crop_image(
        image,
        crop_ratio,
    )

    padded: Image.Image = pad_image(
        cropped,
        padding,
        background,
    )

    available_width: int = max(
        1,
        tile_width - PREVIEW_MARGIN * 2,
    )

    available_height: int = max(
        1,
        tile_height - PREVIEW_MARGIN * 2,
    )

    if size_mode == "fill":
        fitted: Image.Image = apply_size_mode(
            padded,
            (
                available_width,
                available_height,
            ),
            "fill",
        )

        x: int = PREVIEW_MARGIN
        y: int = PREVIEW_MARGIN

        canvas.alpha_composite(
            fitted,
            (x, y),
        )

        return canvas

    fitted = apply_size_mode(
        padded,
        (
            available_width,
            available_height,
        ),
        "fit",
    )

    x = (
        tile_width - fitted.width
    ) // 2

    y = (
        tile_height - fitted.height
    ) // 2

    canvas.alpha_composite(
        fitted,
        (x, y),
    )

    return canvas


def make_output_image(
    image: Image.Image,
    background: RGBColor,
    aspect_ratio: float,
    crop_ratio: CropRatio,
    size_mode: SizeMode,
    padding: int = 0,
) -> Image.Image:
    """
    Create the final saved image.

    The output canvas uses the monitor/screen aspect ratio.

    Processing order:

        original image
             ↓
        crop
             ↓
        padding
             ↓
        fit/fill into screen-aspect canvas
             ↓
        background where required
    """
    cropped: Image.Image = crop_image(
        image,
        crop_ratio,
    )

    padded: Image.Image = pad_image(
        cropped,
        padding,
        background,
    )

    source_width: int
    source_height: int

    source_width, source_height = (
        padded.size
    )

    # For FIT, preserve the original padded pixel dimensions and expand
    # the canvas to the requested aspect ratio.
    if size_mode == "fit":
        canvas_width: int = source_width
        canvas_height: int = source_height

        current_ratio: float = (
            source_width / source_height
        )

        if current_ratio > aspect_ratio:
            canvas_height = math.ceil(
                source_width / aspect_ratio
            )
        else:
            canvas_width = math.ceil(
                source_height * aspect_ratio
            )

        canvas: Image.Image = Image.new(
            "RGBA",
            (
                canvas_width,
                canvas_height,
            ),
            (*background, 255),
        )

        x: int = (
            canvas_width - source_width
        ) // 2

        y: int = (
            canvas_height - source_height
        ) // 2

        canvas.alpha_composite(
            padded,
            (x, y),
        )

        return canvas

    # For FILL, the output canvas is the screen aspect ratio and the
    # image is scaled to completely cover it.
    #
    # Preserve the source dimensions where possible while making the
    # final canvas large enough to contain the scaled image.
    canvas_width = source_width
    canvas_height = source_height

    current_ratio = (
        source_width / source_height
    )

    if current_ratio > aspect_ratio:
        canvas_height = math.ceil(
            source_width / aspect_ratio
        )
    else:
        canvas_width = math.ceil(
            source_height * aspect_ratio
        )

    filled: Image.Image = ImageOps.fit(
        padded,
        (
            canvas_width,
            canvas_height,
        ),
        method=Image.Resampling.LANCZOS,
        centering=(0.5, 0.5),
    )

    # ImageOps.fit already produces the complete canvas.
    return filled


def image_to_texture(
    image: Image.Image,
) -> Gdk.Texture:
    """Convert a Pillow image to a GDK texture."""
    rgba: Image.Image = image.convert(
        "RGBA"
    )

    width: int
    height: int
    width, height = rgba.size

    data: bytes = rgba.tobytes()
    stride: int = width * 4

    glib_bytes: GLib.Bytes = (
        GLib.Bytes.new(data)
    )

    return Gdk.MemoryTexture.new(
        width,
        height,
        Gdk.MemoryFormat.R8G8B8A8,
        glib_bytes,
        stride,
    )


def load_image(
    path: Path,
) -> ImageLoadResult:
    """Load an image and detect its background."""
    with Image.open(path) as opened:
        image: Image.Image = (
            ImageOps.exif_transpose(
                opened
            ).convert("RGBA")
        )

        image.load()

    background: RGBColor = (
        detect_background(image)
    )

    return (
        path,
        image,
        background,
    )


